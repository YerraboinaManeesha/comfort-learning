# Copy this file to .env — but note it's entirely OPTIONAL now.
#
# By default (no .env, or no MONGODB_URI set) the app starts its own
# self-contained, in-memory MongoDB automatically — nothing to install,
# no account to create. Data resets when the server restarts, and the
# course catalogue is auto-seeded again on every startup.
#
# To use a real, persistent database instead (local MongoDB install, or
# a free MongoDB Atlas cluster), uncomment and fill in MONGODB_URI below.

# MONGODB_URI=mongodb://localhost:27017/comfort_learning
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/comfort_learning

SESSION_SECRET=replace_with_a_long_random_string

PORT=3000
